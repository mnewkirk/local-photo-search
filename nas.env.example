# nas.env.example — copy to `nas.env` (git-ignored) and fill in YOUR values.
#
# This repo is public: the NAS's hostname, IP and login must never be
# committed. Every script that talks to the NAS reads them from here (or from
# the environment, which wins). Plain KEY=VALUE lines only — the file is
# parsed, not executed.
#
# Needed on: the desktop replica checkout and any dev checkout that runs
# debug-db.sh or the evals. NOT needed on the NAS itself.

# ssh target for sync-replica.sh / debug-db.sh / run-local-replica.sh --sync
NAS_HOST=<nas-user>@<nas-host>

# NAS web URL — replica image proxy, drift checks, eval thumbnails.
# Use whatever this machine can resolve (hostname, LAN IP or tailnet name).
PHOTOSEARCH_NAS_URL=http://<nas-host>:8000

# Optional — only if the repo is not at the default path on the NAS.
# NAS_COMPOSE_FILE=/volume1/docker/photosearch/docker-compose.nas.yml
