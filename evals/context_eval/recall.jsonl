# Trap-recall questions. One per relocatable CLAUDE.md trap. `expect`: every regex must match the answer; `any`: each group needs one match; `reject`: none may match. Case-insensitive.
{"id": "cli-db-envvar", "area": "patterns", "prompt": "In this repo, what must every CLI command's --db option carry, and why?", "expect": ["PHOTOSEARCH_DB", "envvar|environment[ -]variable"]}
{"id": "db-filename-schema", "area": "database", "prompt": "What is the SQLite database file called, and which constant in which file is the source of truth for the schema version?", "expect": ["photo_index\\.db", "SCHEMA_VERSION", "db\\.py"]}
{"id": "frontend-no-build", "area": "frontend", "prompt": "Can frontend pages use JSX? What does a frontend change require before it shows up on the NAS?", "expect": ["React\\.createElement"], "any": [["rebuild", "docker.*build", "image"]]}
{"id": "sse-loop-and-events", "area": "patterns", "prompt": "For a long-running SSE endpoint in web.py, which asyncio call gets the loop, and which terminal event types must the stream always be able to emit?", "expect": ["get_running_loop", "done", "fatal", "cancelled"]}
{"id": "photodb-no-args", "area": "nas", "prompt": "In an ad-hoc Python snippet run inside the NAS photosearch container, what goes wrong if you write PhotoDB() with no arguments, and what should you pass?", "expect": ["PHOTOSEARCH_DB"], "any": [["/app/photo_index\\.db", "relative", "stub", "empty", "zero"]]}
{"id": "compose-entrypoint", "area": "nas", "prompt": "How do I run `python -c \"...\"` inside the photosearch container with docker compose on the NAS, and where must the entrypoint flag go?", "expect": ["--entrypoint"], "any": [["before.*(service|photosearch)", "docker-entrypoint", "cli\\.py"]]}
{"id": "nas-git-safe-directory", "area": "nas", "prompt": "Why does a bare `git status` fail in the NAS checkout, and what is the one-line fix?", "expect": ["dubious", "safe\\.directory"]}
{"id": "pgrep-self-match", "area": "patterns", "prompt": "Why must a watcher loop never poll `pgrep -f <pattern>`, and what should it watch instead?", "any": [["itself", "its own", "self", "own command line", "own argv"], ["marker", "pid", "kill -0", "done", "terminal event"]]}
{"id": "worker-d-photo-root", "area": "workers", "prompt": "What happens when the worker fleet is started with `-d /photos`, and what should I do to process the whole library?", "expect": ["404"], "any": [["omit", "without -d", "leave.*out", "drop.*-d", "no -d"]]}
{"id": "worker-health-probe", "area": "workers", "prompt": "Which endpoint should a worker probe at startup to check the server is up, and why not /api/stats?", "expect": ["/api/health"], "any": [["117", "slow", "cold", "expensive", "heavy", "count", "scan"]]}
{"id": "tags-pass-removed", "area": "workers", "prompt": "Is `tags` a valid worker pass? If not, which passes replaced it?", "expect": ["category-visual", "category-content", "keywords"]}
{"id": "aesthetics-primary-signal", "area": "llm", "prompt": "Which model scores the `aesthetics` worker pass by default, and why is the LAION aesthetic_score no longer the primary quality signal?", "expect": ["qwen2\\.5-vl"], "any": [["ceiling", "6\\.2", "6\\.9", "compress", "tops out"]]}
{"id": "percentile-chunking", "area": "llm", "prompt": "Why does normalize-aesthetics write percentiles in 2000-row chunks, and what does the WHERE clause of each UPDATE guard on?", "any": [["lock", "locked", "busy_timeout"], ["aes_overall IS", "score it was derived", "old value", "guard"]]}
{"id": "visual-derived-tags", "area": "llm", "prompt": "Which three visual tags are derived from EXIF instead of asked of the vision model, and what are the thresholds?", "expect": ["long-exposure", "low-light", "panoramic"], "any": [["1/4", "0\\.25"], ["EV", "5\\.0", "5"], ["2\\.0", "aspect"]]}
{"id": "visual-frozen-sharp-blurry", "area": "llm", "prompt": "What is the status of the `sharp` and `blurry` visual tags: derived, asked of the model, or something else, and why?", "expect": ["frozen"], "any": [["aes_sharpness", "false positive", "unvalidated", "hand-label", "eval"]]}
{"id": "visual-retired-tag", "area": "llm", "prompt": "Which visual tag was retired from the vocabulary entirely and stripped from existing rows?", "expect": ["motion-blur"]}
{"id": "visual-derived-wins", "area": "llm", "prompt": "In the server-side visual-tag merge, what happens when the model emits `long-exposure` for a 1/800 s frame?", "any": [["strip", "drop", "remove", "discard", "derived wins", "EXIF.*(wins|authoritative)"]]}
{"id": "lmstudio-visual-role-env", "area": "llm", "prompt": "On the LM Studio (OpenAI-compatible) route, which environment variable selects the model for the category-visual pass, and which for category-content and keywords?", "expect": ["PHOTOSEARCH_LLM_VISUAL_MODEL", "PHOTOSEARCH_LLM_TEXT_MODEL"]}
{"id": "reasoning-effort-none", "area": "llm", "prompt": "Why does the worker fleet need PHOTOSEARCH_LLM_REASONING_EFFORT=none for gemma-4 and minicpm, and what is the symptom without it?", "expect": ["none|reasoning_effort"], "any": [["reasoning", "thinking"], ["max_tokens", "empty", "''", "defer", "timeout", "10 s", "blocked"]]}
{"id": "fleet-role-models-location", "area": "llm", "prompt": "Where in the code do the fleet's per-pass (per-role) default model names live, and how do you override one role for the UI-launched fleet?", "expect": ["FLEET_ROLE_MODELS", "rerun"], "any": [["PHOTOSEARCH_FLEET_", "_fleet_env"]]}
{"id": "provenance-effective-model", "area": "llm", "prompt": "generations.model_used said `llava` for almost every category-visual row even though another model ran. Why, and which helper fixes it?", "expect": ["effective_model"], "any": [["role", "nominal", "configured", "ignored", "_resolve_openai_model"]]}
{"id": "text-pass-timeout", "area": "llm", "prompt": "What per-call timeout do the text-only Ollama passes (category-content, keywords) use, and what problem does it bound?", "expect": ["10"], "any": [["stall", "stuck", "hang", "freez"]]}
{"id": "attempts-cap", "area": "workers", "prompt": "After how many failed attempts does a worker pass stop claiming a photo, and which table and column track it?", "expect": ["worker_processed", "attempts"], "any": [["\\b3\\b", "MAX_PROCESS_ATTEMPTS"]]}
{"id": "server-write-failure-attempt", "area": "workers", "prompt": "When the NAS hits a transient `database is locked` while persisting a worker's submitted result, does the photo lose a retry attempt? What happens to the batch?", "any": [["\\bno\\b", "not", "does not", "doesn't"], ["defer", "deferred", "released", "re-claim"]]}
{"id": "faces-empty-terminal", "area": "workers", "prompt": "What does the server do with a clean `faces` result that found nobody in the photo, and why is that safe?", "any": [["terminal", "MAX_PROCESS_ATTEMPTS", "straight to", "exhaust"], ["failure", "exception", "error row", "failures list"]]}
{"id": "video-nas-never-decodes", "area": "video", "prompt": "Does the NAS ever probe or decode video files? Who does, and what tool does that require?", "expect": ["ffprobe"], "any": [["never", "\\bno\\b", "not"], ["worker", "desktop", "native"]]}
{"id": "pass-media-map", "area": "video", "prompt": "What is db.PASS_MEDIA for, and what happens to a worker pass that is missing from it?", "expect": ["raise"], "any": [["still", "video", "\\bany\\b"]]}
{"id": "video-passes-native", "area": "video", "prompt": "Why must the four video worker passes run with --native rather than in the Docker worker fleet?", "expect": ["ffprobe"], "any": [["docker", "image", "container"]]}
{"id": "clip-reclaim-cap", "area": "workers", "prompt": "What was the clip-claim infinite re-claim bug, and how is clip capped today?", "any": [["unloadable", "could not load", "cannot identify", "ZIP", "no trace", "no ledger", "never.*mark_processed"], ["_CLIP_NOT_EXHAUSTED", "attempts", "ledger", "failures"]]}
{"id": "ingest-no-index-trap", "area": "ingest", "prompt": "Why must you never run `ingest-incoming --no-index` to skip CLIP, and what flag should you use instead?", "expect": ["--no-clip"], "any": [["no DB row", "no row", "inserts no rows", "unclaimable", "unsearchable", "invisible"]]}
{"id": "refile-link-not-rename", "area": "ingest", "prompt": "Why does refile-unknown-camera move files with os.link + unlink instead of os.rename or shutil.copy2?", "expect": ["EEXIST"], "any": [["overwrite", "clobber", "silently replace"]]}
{"id": "maintenance-cron-time", "area": "maintenance", "prompt": "Where does the nightly maintenance-sweep cron entry live on the NAS, and at what time does it run?", "any": [["18:30", "30 18", "6:30 ?pm"], ["crontab", "user", "cantimatt"]]}
{"id": "sweep-match-strict-only", "area": "maintenance", "prompt": "Does the nightly maintenance sweep run the temporal face matcher? How would you turn it on?", "any": [["strict", "\\bno\\b", "not", "opt-in"], ["--match-temporal", "match_temporal"]]}
{"id": "exclusions-churn-fix", "area": "faces", "prompt": "The sweep's match_faces and resolve_dups stages used to apply the same ~6000 faces every night. What table stops that loop and what does it remember?", "expect": ["face_person_exclusions"], "any": [["pair", "pairing", "which person", "face.*person"]]}
{"id": "exclusion-strict-vs-temporal", "area": "faces", "prompt": "When a face's best match is a person barred by face_person_exclusions, how do the strict and the temporal matchers behave differently, and why must they not be unified?", "any": [["strict.*(next|fall|runner)", "fall.?through", "next best"], ["temporal.*(unmatched|leaves|refuses|no label)", "leaves.*unmatched", "min_gap", "ambigu"]]}
{"id": "rejected-match-source", "area": "faces", "prompt": "What does match_source='rejected' mean, why does it exist when dedupe_unmatched already did, and how do the matchers honour it?", "expect": ["rejected"], "any": [["MATCHABLE_SQL", "re-appl", "matcher.*skip", "filtered out"], ["dedupe_unmatched"]]}
{"id": "rival-test", "area": "faces", "prompt": "What is the face-label rival test, and why can it find errors the margin test structurally cannot?", "expect": ["same photo"], "any": [["unlabel", "untagged", "not.*registered", "swap"]]}
{"id": "leave-one-burst-out", "area": "faces", "prompt": "Why does verify-face-labels exclude the whole burst rather than just the face itself when measuring a face against its person's references?", "expect": ["burst"], "any": [["impostor", "vouch", "same mistake", "other frame", "1 ?s", "one second", "collapse"]]}
{"id": "ps-poll-not-setinterval", "area": "frontend", "prompt": "How should a frontend page poll a status endpoint, and why is setInterval wrong here?", "expect": ["PS\\.poll"], "any": [["settle", "previous", "came back", "in-flight", "stack", "40 (request )?threads", "starv"]]}
{"id": "frontend-ref-check", "area": "frontend", "prompt": "The frontend has no linter. What catches a helper that is called from a page which never defines it?", "expect": ["check-frontend-refs"]}
{"id": "restart-helper-container", "area": "frontend", "prompt": "Why can't /api/admin/restart run `docker compose up` for photosearch from inside the photosearch container, and what does it do instead?", "expect": ["helper"], "any": [["PID namespace", "dies", "killed", "kill", "stranded", "Created"]]}
{"id": "batch-zero-unprocessed-lies", "area": "ingest", "prompt": "In batch_state, why does count_unprocessed_photos returning 0 not mean a step is completed? Name the two cases.", "any": [["attempts", "exhausted", "blocked"], ["waiting", "description IS NOT NULL", "gated", "describe"]]}
{"id": "batch-queued-source", "area": "ingest", "prompt": "Where does a batch step's `queued` state come from, and what must it never be derived from?", "expect": ["ingest_batch_jobs"], "any": [["fleet-status", "run-workers\\.sh --status", "process list"]]}
{"id": "detect-stacks-empty-list", "area": "maintenance", "prompt": "What happens if detect_stacks or run_stacking is called with photo_ids=[] (an empty list), and why does that matter?", "any": [["whole library", "entire library", "library", "no scope", "unscoped"], ["wipe", "clear", "wiped", "reset", "lost"]]}
{"id": "geocode-oom-per-row", "area": "maintenance", "prompt": "Why did the geocode maintenance stage OOM-kill the NAS container, and what two fixes made it fit in memory?", "any": [["per.?row", "dict", "745"], ["_MIN_POPULATION", "population"], ["stream", "StringIO", "f\\.read"]]}
{"id": "vec0-orphans", "area": "database", "prompt": "Why do orphan rows accumulate in clip_embeddings and face_encodings when photos or faces are deleted, and what cleans them?", "expect": ["cleanup-orphans"], "any": [["vec0", "virtual table"], ["cascade", "foreign"]]}
{"id": "api-intent-headers", "area": "patterns", "prompt": "When a Claude session calls the photosearch HTTP API directly with curl, which headers must it send and why?", "expect": ["X-Photosearch-Source", "X-Photosearch-Intent"]}
{"id": "sharpness-error-vs-absent", "area": "workers", "prompt": "In the sharpness backfill, what is recorded when a file fails to decode, versus when the file is simply not present on this machine?", "any": [["stored", "sharpness_json", "version.*set", "never re-decode"], ["not_local", "nothing", "absent", "records nothing", "not written"]]}
{"id": "mirror-fields-needs-nas", "area": "replica", "prompt": "After a sync-mode re-run from the image view on the replica, why might the result show mirrored:0, and what fixes it?", "expect": ["mirror-fields"], "any": [["404", "older", "redeploy", "deploy the NAS", "NAS.*M28"]]}
