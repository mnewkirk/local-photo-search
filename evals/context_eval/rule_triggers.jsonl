# Rule-trigger items: the harness prefixes "First read the whole file <read> with the Read tool. Then answer: ...". After the restructure each `read` should load the matching .claude/rules/<rule>.md; before it, the answer comes from CLAUDE.md. Graded like recall.
{"id": "rule-faces-separation", "rule": "faces", "read": "photosearch/face_verify.py", "prompt": "In verify-face-labels, what is separation(P, Q), and why is it a percentile rather than min()?", "any": [["5th percentile", "p5", "percentile"], ["min\\(\\)", "minimum", "one bad label", "drags", "disable"]]}
{"id": "rule-llm-unusable-answer", "rule": "llm-passes", "read": "photosearch/describe.py", "prompt": "What does the worker do when describe.UnusableAnswer is raised for a photo, and how does that differ from a transport timeout?", "any": [["failure row", "failures", "index_errors", "one attempt", "attempt spent"], ["defer", "omitted", "transient", "transport"]]}
{"id": "rule-ingest-faces-done", "rule": "ingest", "read": "photosearch/batch_state.py", "prompt": "Which worker pass counts an exhausted photo with no output toward `done` instead of `failed`, and why is that only safe for that pass?", "expect": ["faces"], "any": [["nobody", "no face", "no detectable", "empty.*(result|output)"]]}
{"id": "rule-maintenance-stacking-incremental", "rule": "maintenance", "read": "photosearch/maintenance.py", "prompt": "Is the maintenance sweep's stacking stage a full re-detect or missing-only? What ledger makes that possible and what can it never do?", "any": [["stacking_seen", "incremental", "missing-only", "dirty"], ["never.*(wipe|clear)", "clear_stacks", "unscoped"]]}
{"id": "rule-workers-failures-list", "rule": "workers", "read": "photosearch/worker.py", "prompt": "When processing a photo raises a non-transient exception in a worker pass, what does the worker send to the server for it, and what does the server do with that?", "any": [["failures", "FailedResult", "failure row", "_failure_row"], ["one attempt", "attempt", "index_errors"]]}
{"id": "rule-video-probe-owner", "rule": "video", "read": "photosearch/video_probe.py", "prompt": "Which machine runs the video probe and scan, and what is the NAS's role for video?", "any": [["worker", "desktop", "native"], ["never.*(decode|probe)", "stores", "serves", "Range", "walks"]]}
{"id": "rule-print-topaz-exit-code", "rule": "print", "read": "photosearch/upscale.py", "prompt": "How does the Topaz upscale integration decide that a run succeeded, and why not the exit code?", "any": [["output file", "file appear", "new file", "file shows up", "exists"], ["\\b9\\b", "127", "wrong", "non-zero", "exit code"]]}
{"id": "rule-frontend-ps-poll", "rule": "frontend", "read": "frontend/dist/shared.js", "prompt": "What does PS.poll do differently from setInterval, and what incident motivated it?", "expect": ["setInterval"], "any": [["settle", "after.*resolve", "previous", "re-arm", "hidden"], ["SMB", "2026-09-19", "40", "starv", "disk"]]}
{"id": "rule-search-compose-scope", "rule": "search", "read": "photosearch/search.py", "prompt": "What does _compose_scope in search_combined do, and which three filter kinds does it fold into the id scope?", "expect": ["scope"], "any": [["date", "camera", "people|person"]]}
