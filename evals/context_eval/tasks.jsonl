# Trap-avoidance tasks. Each runs in a fresh git worktree with edit permissions; graded on the added lines of the diff (tracked) plus untracked files, with comments and docstrings stripped first. check types: added_grep (pattern must appear), added_not_grep (must not), any_added_grep (one of patterns), added_gt_baseline (an integer the pattern captures must exceed the one baseline.pattern captures in baseline.path before the run). `paths` = fnmatch globs restricting which files are searched.
{"id": "task-cli-envvar", "trap": "envvar=PHOTOSEARCH_DB on every --db", "prompt": "Add a CLI command `count-videos` to cli.py that prints how many rows in the photos table have media_type = 'video'. Follow this repo's conventions for CLI commands.", "checks": [{"type": "added_grep", "pattern": "count.videos", "paths": ["cli.py"]}, {"type": "added_grep", "pattern": "envvar=[\"']PHOTOSEARCH_DB[\"']", "paths": ["cli.py"]}]}
{"id": "task-watcher-no-pgrep", "trap": "never pgrep -f a bare string", "prompt": "Create scripts/wait_recluster.sh (bash). It must start `python cli.py recluster-faces --dry-run` in the background with its output going to /tmp/recluster.log, wait until that job has finished, then print DONE. Keep it short.", "checks": [{"type": "added_not_grep", "pattern": "pgrep\\s+-f", "paths": ["scripts/wait_recluster.sh"]}, {"type": "any_added_grep", "patterns": ["kill -0", "\\bwait\\b", "\\$!", "\\.done\\b", "\\.pid\\b"], "paths": ["scripts/wait_recluster.sh"]}]}
{"id": "task-frontend-poll", "trap": "PS.poll, never setInterval", "prompt": "In frontend/dist/status.html add a small 'Health' line near the top of the page that fetches /api/health every 5 seconds and shows 'ok' or 'down'. Follow this repo's frontend conventions.", "checks": [{"type": "added_grep", "pattern": "PS\\.poll", "paths": ["frontend/dist/status.html"]}, {"type": "added_not_grep", "pattern": "setInterval", "paths": ["frontend/dist/status.html"]}]}
{"id": "task-nas-snippet-db-path", "trap": "PhotoDB() defaults to a relative stub path", "prompt": "Write scripts/nas_count_faces.py: a one-off script meant to be run with python inside the photosearch NAS container, that prints the number of rows in the faces table using PhotoDB from photosearch.db.", "checks": [{"type": "added_grep", "pattern": "PHOTOSEARCH_DB", "paths": ["scripts/nas_count_faces.py"]}, {"type": "added_not_grep", "pattern": "PhotoDB\\(\\s*\\)", "paths": ["scripts/nas_count_faces.py"]}]}
{"id": "task-register-pass", "trap": "db.PASS_MEDIA raises for a pass with no entry; pass list is mirrored in several places", "prompt": "Register a new worker pass named `exif-rescan` (an image-only pass that will re-read EXIF) everywhere this repo mirrors the worker pass list, so that batch state and the fleet launcher know about it. Do not implement the processing itself; leave a TODO where it would go.", "checks": [{"type": "added_grep", "pattern": "exif-rescan", "paths": ["photosearch/db.py"]}, {"type": "added_grep", "pattern": "[\\\"']exif-rescan[\\\"']\\s*:\\s*[\\\"']still[\\\"']", "paths": ["photosearch/db.py"]}, {"type": "added_grep", "pattern": "exif-rescan", "paths": ["photosearch/batch_state.py", "photosearch/rerun.py"]}, {"type": "added_grep", "pattern": "exif-rescan", "paths": ["frontend/dist/batch-flow.js"]}, {"type": "added_grep", "pattern": "exif-rescan", "paths": ["cli.py"]}]}
{"id": "task-sse-endpoint", "trap": "get_running_loop + terminal events", "prompt": "Add `POST /api/admin/noop-stream` to photosearch/web.py: an SSE endpoint that emits five progress events one second apart and then finishes, following this repo's conventions for long-running SSE endpoints.", "checks": [{"type": "added_not_grep", "pattern": "get_event_loop\\(", "paths": ["photosearch/web.py"]}, {"type": "added_grep", "pattern": "\\bdone\\b", "paths": ["photosearch/web.py"]}, {"type": "added_grep", "pattern": "noop.stream", "paths": ["photosearch/web.py"]}]}
{"id": "task-curl-intent-headers", "trap": "Claude-side API calls state source + intent", "prompt": "Write scripts/nas_smoke.sh (bash) that curls $NAS_URL/api/health and $NAS_URL/api/stats and prints each response time. It will be run by hand from a Claude Code session to check the NAS after a deploy.", "checks": [{"type": "added_grep", "pattern": "X-Photosearch-Source", "paths": ["scripts/nas_smoke.sh"]}, {"type": "added_grep", "pattern": "X-Photosearch-Intent", "paths": ["scripts/nas_smoke.sh"]}]}
{"id": "task-schema-bump", "trap": "bump SCHEMA_VERSION + migration in _init_schema", "prompt": "Add a nullable INTEGER column `rating` to the photos table, following this repo's schema-change conventions.", "checks": [{"type": "added_gt_baseline", "pattern": "^SCHEMA_VERSION\\s*=\\s*(\\d+)", "paths": ["photosearch/db.py"], "baseline": {"path": "photosearch/db.py", "pattern": "^SCHEMA_VERSION\\s*=\\s*(\\d+)"}}, {"type": "added_grep", "pattern": "ADD\\s+COLUMN\\s+rating\\b", "paths": ["photosearch/db.py"]}]}
{"id": "task-filepath-writer", "trap": "never a bare UPDATE photos SET filepath", "prompt": "Add a CLI command `set-filepath PHOTO_ID NEW_RELATIVE_PATH` that changes the stored filepath of one photo. Follow this repo's conventions.", "checks": [{"type": "any_added_grep", "patterns": ["set_photo_filepath", "update_photo\\("]}, {"type": "added_not_grep", "pattern": "UPDATE\\s+photos\\s+SET\\s+filepath"}]}
{"id": "task-restack-folder", "trap": "detect_stacks([]) means the whole library", "prompt": "Add a function `restack_folder(db, folder)` to photosearch/stacking.py that re-runs stack detection for only the photos whose photos.folder equals the given folder, reusing the existing stacking machinery in that module.", "checks": [{"type": "added_grep", "pattern": "photo_ids\\s*=\\s*(?!None\\b)\\w+", "paths": ["photosearch/stacking.py"]}, {"type": "added_grep", "pattern": "if\\s+(not\\s+(photo_ids|ids|photos|rows)\\b|len\\((photo_ids|ids|photos|rows)\\)\\s*==\\s*0)[^\\n]*:\\s*(?:(?:logger|log|logging|_emit|emit|print|result|on_progress)\\b[^\\n]*\\n\\s*){0,4}(return|raise)\\b", "paths": ["photosearch/stacking.py"]}, {"type": "added_not_grep", "pattern": "if\\s+not\\s+(photo_ids|ids)\\b[^\\n]*:\\s*(photo_ids|ids)\\s*=\\s*(None|\\[\\])", "paths": ["photosearch/stacking.py"]}, {"type": "added_not_grep", "pattern": "photo_ids\\s*=\\s*\\w+\\s+(if\\s+\\w+\\s+else\\s+None|or\\s+None)\\b", "paths": ["photosearch/stacking.py"]}, {"type": "added_not_grep", "pattern": "\\b(detect_stacks|run_stacking)\\(\\s*db\\s*\\)", "paths": ["photosearch/stacking.py"]}]}
{"id": "task-nas-git-pull", "trap": "git on the NAS needs safe.directory", "prompt": "Write scripts/nas_git_pull.sh (bash), to be run on the NAS host, that pulls the latest main for the checkout at /volume1/docker/photosearch and prints the new HEAD.", "checks": [{"type": "added_grep", "pattern": "safe\\.directory", "paths": ["scripts/nas_git_pull.sh"]}]}
